# Chaves aceitas no header X-API-Key (separadas por vírgula). Vazio = API aberta.
API_KEYS=troque-por-uma-chave-longa-e-aleatoria

# Origem(ns) do frontend no Cloudflare Pages
CORS_ORIGINS=https://ocr-analab.pages.dev

# Tamanho máximo do upload
MAX_UPLOAD_MB=10

# Domínio da API (Caddy emite HTTPS automático via Let's Encrypt)
DOMAIN=ocr-api.seudominio.com.br
